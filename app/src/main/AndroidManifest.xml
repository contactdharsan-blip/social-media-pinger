<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QuietPing is fully on-device. There is DELIBERATELY no INTERNET permission:
      the OS itself then guarantees zero exfiltration of captured message content
      (PRD §11). Do not add networking.
    -->

    <!-- Read the local SMS/MMS store for full-history + deletion diffing (PRD 6A). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Post the re-notification heads-up alerts (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allow VIP / name conditions to bypass Do Not Disturb (PRD §8). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- CRITICAL alert style: full-screen heads-up that wakes the screen (Bundle 1).
         On Android 14+ this is user-grantable for non-call/alarm apps; harmless if denied. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Rebind the notification listener after reboot (PRD 6F). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional biometric app lock for the Vault (PRD §11). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Foreground service for the SMS ContentObserver / listener keep-alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Read chat-app media so the MediaObserver can copy images/video/voice notes into
      the private MediaVault BEFORE a "delete for everyone" removes the original
      (PRD §6 / on-device only — there is still no INTERNET permission, so nothing
      captured can leave the device). Granular READ_MEDIA_* on Android 13+; the
      legacy READ_EXTERNAL_STORAGE is capped to API 32 and below.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:name=".QuietPingApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuietPing"
        tools:targetApi="34">

        <!--
          Single host Activity for the whole Compose app. It is exported so the
          launcher aliases (which carry the LAUNCHER intent-filters) can target
          it, but it has NO launcher intent-filter of its own.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.QuietPing" />

        <!-- App-icon switcher (PRD 6E): one alias per selectable icon. Exactly
             one is enabled at a time via PackageManager.setComponentEnabledSetting.
             Default ships enabled; the others ship disabled. -->
        <activity-alias
            android:name=".alias.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name_default"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.Mono"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_mono"
            android:label="@string/app_name_mono"
            android:roundIcon="@drawable/ic_launcher_mono"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguised icon (privacy feature): reads as a generic utility. -->
        <activity-alias
            android:name=".alias.Stealth"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_stealth"
            android:label="@string/app_name_stealth"
            android:roundIcon="@drawable/ic_launcher_stealth"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Primary capture source: reads StatusBarNotification extras for all
             chat apps (PRD §4). Bound by the system. -->
        <service
            android:name=".capture.PingNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Opt-in Accessibility booster (PRD 4 / 13 V3): scoped to the target
             packages via @xml/accessibility_service_config. -->
        <service
            android:name=".capture.PingAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Face 2 — Xposed/LSPosed module metadata (FACE2_XPOSED_RD.md). Present on every
          install but INERT unless the device is rooted with LSPosed AND the user enables the
          module + scopes it. LSPosed reads these to load the hook into the target processes.
          No INTERNET, no extra runtime lib: the Xposed API is compileOnly (provided by the
          framework, never bundled). Scope is fixed to the chat-app packages only.
        -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_description" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <!--
          Face 2 → Face 1 vault bridge sink (FACE2_XPOSED_RD.md §9). Receives a recovered
          "delete for everyone" message from the Xposed hook running inside the target app's
          process, via ContentProvider.call(). MUST be exported to accept a cross-UID call, but
          the provider authenticates every delivery by KERNEL-ENFORCED caller UID
          (Binder.getCallingUid must resolve to a target package) — no shared secret, no spoofing.
          Still on-device — no INTERNET.
        -->
        <provider
            android:name=".capture.DeepCaptureProvider"
            android:authorities="com.quietping.deepcapture"
            android:enabled="true"
            android:exported="true" />

        <!-- Rebind capture after reboot (PRD 6F). -->
        <receiver
            android:name=".capture.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
