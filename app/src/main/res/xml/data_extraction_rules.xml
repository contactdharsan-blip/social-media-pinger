<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy hardening (PRD §11): the Vault stores other people's message content,
  so NOTHING is ever backed up or transferred off-device. Exclude all domains
  from both cloud backup and device-to-device transfer. This complements
  android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
