<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Platform theme. The real UI is Compose + Material3 (com.quietping.ui.theme),
      so this XML theme only governs the window the Activity lives in: near-black
      background to avoid a white flash before Compose draws, transparent system
      bars for edge-to-edge, and the emerald accent for any platform chrome.
    -->
    <style name="Theme.QuietPing" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/qp_canvas</item>
        <item name="android:colorBackground">@color/qp_canvas</item>

        <!-- Accent for platform chrome (framework attrs only; the real color
             scheme is driven by Compose Material3 in com.quietping.ui.theme) -->
        <item name="android:colorPrimary">@color/md_theme_dark_primary</item>
        <item name="android:colorAccent">@color/qp_emerald_400</item>

        <!-- Edge-to-edge: transparent status + navigation bars -->
        <item name="android:statusBarColor">@color/qp_transparent</item>
        <item name="android:navigationBarColor">@color/qp_transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
