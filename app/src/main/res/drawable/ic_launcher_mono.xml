<?xml version="1.0" encoding="utf-8"?>
<!--
  "Mono" launcher alias icon: a single-color emerald droplet glyph on the
  near-black canvas. Flatter and quieter than the default gradient droplet, for
  users who prefer a monochrome home screen. Self-contained (the alias points at
  a regular drawable, not an adaptive layer), so the canvas is baked in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Canvas -->
    <path
        android:fillColor="#030712"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Single-tone emerald droplet -->
    <path
        android:fillColor="#FF34D399"
        android:pathData="M54,30
            C54,30 39,49 39,62
            C39,71.39 45.72,78 54,78
            C62.28,78 69,71.39 69,62
            C69,49 54,30 54,30 Z" />

    <!-- Negative-space highlight punched out for a flat mono look -->
    <path
        android:fillColor="#030712"
        android:pathData="M54,44
            C50.5,49 48.5,55 49,61
            C49.4,65 51,67 53,67
            C50.5,63 50,55 54,44 Z" />
</vector>
