<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: an emerald->teal "liquid glass" water droplet,
  centered within the 72dp safe zone of the 108dp adaptive canvas. The vertical
  gradient (emerald 300 at the top -> teal 600 at the base) plus a translucent
  white highlight reads as a frosted glass drop on the near-black background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Droplet body: classic teardrop, point up, round base. -->
    <path
        android:pathData="M54,28
            C54,28 38,48 38,62
            C38,71.94 45.16,79 54,79
            C62.84,79 70,71.94 70,62
            C70,48 54,28 54,28 Z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="28"
                android:endX="54"
                android:endY="79">
                <item android:offset="0.0" android:color="#FF6EE7B7" />
                <item android:offset="0.45" android:color="#FF34D399" />
                <item android:offset="1.0" android:color="#FF0D9488" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner glass highlight: a soft crescent on the upper-left of the drop. -->
    <path
        android:fillColor="#59FFFFFF"
        android:pathData="M50,46
            C46,52 44,58 44.5,64
            C45,68 47,70 49.5,70
            C46,66 46,58 50,46 Z" />

    <!-- Specular dot for the wet "glass" sheen. -->
    <path
        android:fillColor="#A6FFFFFF"
        android:pathData="M59,64
            m-3.2,0
            a3.2,3.2 0 1,0 6.4,0
            a3.2,3.2 0 1,0 -6.4,0 Z" />
</vector>
